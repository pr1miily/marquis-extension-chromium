# Chrome-generated on unpacked load (DNR ruleset index)
_metadata/

# Extension packaging: "Pack extension" writes the signing key (.pem) next to the .crx. Never commit the key:
# it lets anyone publish updates as this extension. Store-upload zips are rebuilt from the source tree.
*.pem
*.crx
*.zip

# Private developer notes (license / discount codes): kept locally, never published
READ ME.txt

# Private keys and certificates
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Environment and local credentials (no build step reads them; keep secrets out of the repo)
.env
.env.*
!.env.example
.npmrc
.netrc
*credentials*.json
*service-account*.json

# Local tool and AI-assistant settings (may hold personal paths or tokens)
.claude/settings.local.json
.vscode/
.idea/
*.code-workspace
graphify-out/

# Dependencies and generated output (there is no build step today; ignore them if one is added)
node_modules/
coverage/
*.log
npm-debug.log*

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
*.bak
*.tmp

# Local captures, recordings and exports made while testing the extension
*.webm
captures/
recordings/
exports/
