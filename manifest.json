{
  "manifest_version": 3,
  "name": "Marquis of Meow'An",
  "version": "4.0.41926",
  "description": "A multifunction Browser Extension designed to serve as a centralized digital workspace",
  "permissions": [
    "activeTab",
    "offscreen",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "windows",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "power",
    "tabGroups",
    "alarms",
    "geolocation",
    "declarativeNetRequest"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scripts/dock_loader.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "https://meet.google.com/*"
  ],
  "icons": {
    "16": "img/46087a1c-4b4d-4a36-a268-1b57cb06908c.png",
    "48": "img/46087a1c-4b4d-4a36-a268-1b57cb06908c.png",
    "128": "img/46087a1c-4b4d-4a36-a268-1b57cb06908c.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "diffWindow.html",
        "blocked.html",
        "heartbeat.html",
        "simulator.html",
        "kanban_fullscreen.html",
        "bulk_url_tools.html",
        "styles/*",
        "img/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "Marquis.html",
    "default_title": "Marquis",
    "default_icon": {
      "16": "img/46087a1c-4b4d-4a36-a268-1b57cb06908c.png",
      "24": "img/46087a1c-4b4d-4a36-a268-1b57cb06908c.png",
      "32": "img/46087a1c-4b4d-4a36-a268-1b57cb06908c.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}